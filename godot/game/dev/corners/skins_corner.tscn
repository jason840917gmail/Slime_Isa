[node name="skins-corner" type="Node2D"]
y_sort_enabled = true
script = ExtResource("script")

[node name="title" type="Label" parent="."]
offset_left = 6700
offset_top = 600
offset_right = 7900
offset_bottom = 700
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "Skins corner (roadmap 7.8; docs/godot/SKINS.md)
Each pedestal lends its skin for this session (interact again to give it back). A won skin is always on;
the bag's Skins row only picks the look. Try every lock with and without its skin."

[node name="heavy-sign" type="Label" parent="."]
offset_left = 6700
offset_top = 720
offset_right = 7900
offset_bottom = 760
mouse_filter = 2
theme_override_font_sizes/font_size = 13
text = "HEAVY: the plate sinks, the statue moves (hold interact by it), and a Roll smashes the old things and shakes the pouch out of the tree."

