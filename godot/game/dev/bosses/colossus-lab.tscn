[node name="lobby-note" type="Label" parent="Objects" unique_id=138710037]
modulate = Color(1, 0.96, 0.84, 0.9)
offset_left = 912.0
offset_top = 1356.0
offset_right = 1532.0
offset_bottom = 1416.0
theme_override_font_sizes/font_size = 13
text = "Colossus lab (the plate fight). Walk north to wake him; back into this nook to start over. Light a brazier with the Lantern (its flame flies in a line), bait him over the rails in its light, throw at that line's target: the cart bursts a hot plate, and he kicks it back. Keep away and he leaps at you. When he rears and the floor cracks, climb the roots: the quake hurts all over the floor for 5 s. His stomps put braziers out only once all four burn and he is hurt, or 45 s after a brazier was last lit or put out. Bare crystal takes the Spear; with two plates gone, climb the roots and Spear his claws: he falls across the line under him. The dips are void."
autowrap_mode = 3

