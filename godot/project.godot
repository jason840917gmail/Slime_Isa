; Engine configuration file.
; Generated once for the Godot migration (docs/GODOT_MIGRATION.md); edit in the Godot editor from now on.

config_version=5

[application]

config/name="Slime Isa"
config/description="Top-down slime adventure (Godot port)."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameConstants="*res://game/autoload/game_constants.gd"
SimClock="*res://game/autoload/sim_clock.gd"
WorldService="*res://game/autoload/world_service.gd"
DamageRouter="*res://game/combat/damage_router.gd"
GameFeel="*res://game/feel/game_feel.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[importer_defaults]

texture={
"compress/lossy_quality": 0.9,
"compress/mode": 1
}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":true)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":true)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
stretch_lash={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
squash_slam={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
teleport={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
eat={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5,"pressed":true)]
}
weapon_previous={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4,"pressed":true)]
}
menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":61), Object(InputEventKey,"physical_keycode":4194437)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":45), Object(InputEventKey,"physical_keycode":4194435)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="hurtbox"
2d_physics/layer_5="hitbox"
2d_physics/layer_6="pickup-seeker"
2d_physics/layer_7="pickup"
2d_physics/layer_8="npc"
2d_physics/layer_9="projectile"
2d_physics/layer_10="trigger"
2d_physics/layer_11="water"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=5
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0431373, 0.0627451, 0.12549, 1)
