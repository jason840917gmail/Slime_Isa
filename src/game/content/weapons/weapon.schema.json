{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weapon.schema.json",
  "title": "Slime Isa weapon definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "weaponId", "displayName", "category", "baseDamage", "cooldownMs", "hitboxWidth", "hitboxHeight", "hitboxOffset", "hitboxDurationMs", "knockStrength", "vfxColor", "unlockLevel", "iconKey", "description"],
  "anyOf": [
    { "required": ["characterActionId"] },
    { "required": ["animKey"] }
  ],
  "properties": {
    "version": { "const": 1 },
    "weaponId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "enum": ["melee", "ranged"] },
    "animKey": { "type": "string" },
    "characterActionId": { "type": "string", "minLength": 1 },
    "assetId": { "type": "string" },
    "animations": {
      "type": "object", "additionalProperties": false,
      "required": ["idle", "attack", "impact"],
      "properties": {
        "idle": { "$ref": "#/$defs/animation" },
        "attack": { "$ref": "#/$defs/animation" },
        "impact": { "$ref": "#/$defs/animation" }
      }
    },
    "directionalAttacks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "right": { "$ref": "#/$defs/directionalAttack" },
        "left": { "$ref": "#/$defs/directionalAttack" },
        "up": { "$ref": "#/$defs/directionalAttack" },
        "down": { "$ref": "#/$defs/directionalAttack" },
        "side": { "$ref": "#/$defs/directionalAttack", "deprecated": true }
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceOffset"],
      "properties": {
        "sourceOffset": {
          "type": "array",
          "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
          "minItems": 2,
          "maxItems": 2
        },
        "animationOffsets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/offset" } },
        "frameOffsets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/offset" } },
        "origin": { "$ref": "#/$defs/offset" },
        "scale": { "$ref": "#/$defs/offset" },
        "facingMode": { "enum": ["vector", "horizontal-flip"] }
      }
    },
    "hitboxes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hitbox" } },
    "attackTrack": { "$ref": "#/$defs/attackTrack" },
    "baseDamage": { "type": "number", "minimum": 0 },
    "cooldownMs": { "type": "number", "exclusiveMinimum": 0 },
    "hitboxWidth": { "type": "number", "exclusiveMinimum": 0 },
    "hitboxHeight": { "type": "number", "exclusiveMinimum": 0 },
    "hitboxOffset": { "type": "number" },
    "hitboxDurationMs": { "type": "number", "exclusiveMinimum": 0 },
    "knockStrength": { "type": "number", "minimum": 0 },
    "scaling": { "type": "object" },
    "vfxColor": { "type": "integer", "minimum": 0 },
    "unlockLevel": { "type": "integer", "minimum": 1 },
    "iconKey": { "type": "string" },
    "description": { "type": "string", "maxLength": 240 }
  },
  "$defs": {
    "animation": {
      "type": "object", "additionalProperties": false,
      "required": ["frames", "framesPerSecond", "loop"],
      "properties": {
        "frames": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
        "keyframeTimes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "framesPerSecond": { "type": "integer", "minimum": 1, "maximum": 240 },
        "loop": { "type": "boolean" },
        "loopMode": { "enum": ["wrap", "ping-pong"] },
        "frameTransforms": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/frameTransform" }
        }
      }
    },
    "frameTransform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": { "$ref": "#/$defs/offset" },
        "scale": { "$ref": "#/$defs/frameScale" },
        "rotationDeg": { "type": "number" }
      }
    },
    "directionalAttack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["animation"],
      "properties": {
        "animation": { "$ref": "#/$defs/animation" },
        "characterActionId": { "type": "string", "minLength": 1 },
        "attackTrack": { "$ref": "#/$defs/attackTrack" },
        "hitboxes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hitbox" } }
      }
    },
    "offset": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "frameScale": {
      "type": "array",
      "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
      "minItems": 2,
      "maxItems": 2
    },
    "hitbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "width", "height", "offsetX", "offsetY"],
      "allOf": [
        {
          "if": { "properties": { "shape": { "const": "sector" } }, "required": ["shape"] },
          "then": { "required": ["outerRadius", "arcWidthRad"] }
        }
      ],
      "properties": {
        "shape": { "enum": ["rectangle", "circle", "ellipse", "sector"] },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "minimum": 0 },
        "radiusX": { "type": "number", "minimum": 0 },
        "radiusY": { "type": "number", "minimum": 0 },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "innerRadius": { "type": "number", "minimum": 0 },
        "outerRadius": { "type": "number", "minimum": 0 },
        "arcWidthRad": { "type": "number", "minimum": 0, "maximum": 6.283185307179586 },
        "damageMultiplier": { "type": "number", "minimum": 0 },
        "knockbackMultiplier": { "type": "number", "minimum": 0 }
      }
    },
    "attackTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hitboxSpans"],
      "properties": {
        "hitboxSpans": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hitboxId", "from", "through"],
            "properties": {
              "hitboxId": { "type": "string", "minLength": 1 },
              "from": { "type": "integer", "minimum": 0 },
              "through": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "eventId"],
            "properties": {
              "at": { "type": "integer", "minimum": 0 },
              "eventId": { "type": "string", "minLength": 1 },
              "payload": {}
            }
          }
        }
      }
    }
  }
}
