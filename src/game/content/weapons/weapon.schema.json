{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weapon.schema.json",
  "title": "Slime Isa weapon definition",
  "oneOf": [
    { "$ref": "#/$defs/legacyWeapon" },
    { "$ref": "#/$defs/layeredWeapon" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["weaponId", "displayName", "category", "baseDamage", "cooldownMs", "hitboxWidth", "hitboxHeight", "hitboxOffset", "hitboxDurationMs", "knockStrength", "vfxColor", "unlockLevel", "iconKey", "description"],
      "properties": {
        "$schema": { "type": "string" }, "weaponId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }, "category": { "enum": ["melee", "ranged"] },
        "characterActionId": { "type": "string", "minLength": 1 }, "baseDamage": { "type": "number", "minimum": 0 },
        "cooldownMs": { "type": "number", "minimum": 0 }, "hitboxWidth": { "type": "number", "minimum": 0 },
        "hitboxHeight": { "type": "number", "minimum": 0 }, "hitboxOffset": { "type": "number" },
        "hitboxDurationMs": { "type": "number", "minimum": 0 }, "knockStrength": { "type": "number", "minimum": 0 },
        "scaling": { "type": "object" },
        "damageModifiers": { "type": "array", "items": { "$ref": "#/\u0024defs/damageModifier" } },
        "vfxColor": { "type": "integer", "minimum": 0 },
        "unlockLevel": { "type": "integer", "minimum": 1 }, "iconKey": { "type": "string" }, "description": { "type": "string" }, "onResourceHitEffectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    },
    "legacyWeapon": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object", "required": ["version"],
          "properties": { "version": { "const": 1 }, "animKey": { "type": "string" }, "assetId": { "type": "string" }, "animations": { "type": "object" }, "directionalAttacks": { "type": "object" }, "visual": { "type": "object" }, "hitboxes": { "type": "object" }, "attackTrack": { "type": "object" }, "revision": { "type": "string" } }
        }
      ]
    },
    "layeredWeapon": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["version", "$schema", "weaponId", "displayName", "category", "characterActionId", "animations", "directionalAttacks", "baseDamage", "cooldownMs", "hitboxWidth", "hitboxHeight", "hitboxOffset", "hitboxDurationMs", "knockStrength", "vfxColor", "unlockLevel", "iconKey", "description"],
          "properties": {
            "$schema": { "type": "string" }, "version": { "const": 2 }, "weaponId": { "type": "string" }, "displayName": { "type": "string" }, "category": { "enum": ["melee", "ranged"] },
            "characterActionId": { "type": "string", "minLength": 1 },
            "animations": { "type": "object", "additionalProperties": false, "required": ["idle"], "properties": { "idle": { "$ref": "#/$defs/layeredAnimation" } } },
            "directionalAttacks": { "type": "object", "additionalProperties": false, "required": ["right", "down"], "properties": { "right": { "$ref": "#/$defs/layeredAttack" }, "left": { "$ref": "#/$defs/layeredAttack" }, "up": { "$ref": "#/$defs/layeredAttack" }, "down": { "$ref": "#/$defs/layeredAttack" } } },
            "presentation": { "type": "object", "additionalProperties": false, "properties": { "facingMode": { "enum": ["vector", "horizontal-flip"] } } },
            "onHitEffectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "onResourceHitEffectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "baseDamage": { "type": "number" }, "cooldownMs": { "type": "number" }, "hitboxWidth": { "type": "number" }, "hitboxHeight": { "type": "number" }, "hitboxOffset": { "type": "number" }, "hitboxDurationMs": { "type": "number" }, "knockStrength": { "type": "number" }, "scaling": { "type": "object" }, "damageModifiers": { "type": "array", "items": { "$ref": "#/\u0024defs/damageModifier" } }, "vfxColor": { "type": "integer" }, "unlockLevel": { "type": "integer" }, "iconKey": { "type": "string" }, "description": { "type": "string" }
          }
        }
      ]
    },
    "damageModifier": { "type": "object", "additionalProperties": false, "required": ["targetTag", "modifier"], "properties": { "targetTag": { "type": "string", "minLength": 1 }, "modifier": { "type": "number", "minimum": 0 } } },
    "pair": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "transform": { "type": "object", "additionalProperties": false, "properties": { "offset": { "$ref": "#/$defs/pair" }, "scale": { "$ref": "#/$defs/pair" }, "origin": { "$ref": "#/$defs/pair" }, "rotationDeg": { "type": "number" }, "flipX": { "type": "boolean" }, "flipY": { "type": "boolean" } } },
    "blockTransform": { "type": "object", "additionalProperties": false, "properties": { "offset": { "$ref": "#/$defs/pair" }, "scale": { "$ref": "#/$defs/pair" }, "rotationDeg": { "type": "number" }, "flipX": { "type": "boolean" }, "flipY": { "type": "boolean" } } },
    "layeredAnimation": { "type": "object", "additionalProperties": false, "required": ["version", "durationSeconds", "framesPerSecond", "loop", "layers"], "properties": { "version": { "const": 2 }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }, "framesPerSecond": { "type": "integer", "minimum": 1, "maximum": 240 }, "loop": { "type": "boolean" }, "loopMode": { "enum": ["wrap", "ping-pong"] }, "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } } } },
    "layer": { "type": "object", "additionalProperties": false, "required": ["layerId", "displayName", "assetId", "depthOffset", "blocks"], "properties": { "layerId": { "type": "string" }, "displayName": { "type": "string" }, "assetId": { "type": "string" }, "depthOffset": { "type": "number" }, "transform": { "$ref": "#/$defs/transform" }, "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } } } },
    "block": { "type": "object", "additionalProperties": false, "required": ["from", "through", "sourceFrame"], "properties": { "from": { "type": "integer", "minimum": 0 }, "through": { "type": "integer", "minimum": 0 }, "sourceFrame": { "type": "integer", "minimum": 0 }, "transform": { "$ref": "#/$defs/blockTransform" } } },
    "layeredAttack": { "type": "object", "additionalProperties": false, "required": ["animation", "characterActionId", "hitboxes"], "properties": { "animation": { "$ref": "#/$defs/layeredAnimation" }, "characterActionId": { "type": "string" }, "hitboxes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hitbox" } }, "attackTrack": { "$ref": "#/$defs/attackTrack" } } },
    "hitbox": { "type": "object", "required": ["shape", "width", "height", "offsetX", "offsetY"], "properties": { "shape": { "enum": ["rectangle", "circle", "ellipse", "sector"] }, "width": { "type": "number" }, "height": { "type": "number" }, "radius": { "type": "number" }, "radiusX": { "type": "number" }, "radiusY": { "type": "number" }, "offsetX": { "type": "number" }, "offsetY": { "type": "number" }, "innerRadius": { "type": "number" }, "outerRadius": { "type": "number" }, "arcWidthRad": { "type": "number" }, "damageMultiplier": { "type": "number" }, "knockbackMultiplier": { "type": "number" } } },
    "attackTrack": { "type": "object", "required": ["hitboxSpans"], "properties": { "hitboxSpans": { "type": "array", "items": { "type": "object", "required": ["hitboxId", "from", "through"], "properties": { "hitboxId": { "type": "string" }, "from": { "type": "integer" }, "through": { "type": "integer" } } } }, "events": { "type": "array", "items": { "type": "object", "required": ["at", "eventId"], "properties": { "at": { "type": "integer" }, "eventId": { "type": "string" }, "payload": {} } } } } }
  }
}
