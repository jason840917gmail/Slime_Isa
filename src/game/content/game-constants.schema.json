{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-constants.schema.json",
  "title": "Slime Isa gameplay configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "resources",
    "inventory",
    "character",
    "worldNavigation",
    "rest",
    "gulp",
    "input"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player"
      ],
      "properties": {
        "player": {
          "$ref": "#/$defs/player"
        }
      }
    },
    "worldNavigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeTransitionGraceMs"
      ],
      "properties": {
        "edgeTransitionGraceMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sleepHpRegenPerSec"
      ],
      "properties": {
        "sleepHpRegenPerSec": {
          "description": "HP restored per second while the player sleeps in a bed.",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "gulp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formDurationMs"
      ],
      "properties": {
        "formDurationMs": {
          "description": "How long a Gulp form lasts after eating its material, in milliseconds. Eating the same material at a Gulp spot restarts the timer.",
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bufferMs",
        "weaponWheelStepLockMs"
      ],
      "properties": {
        "bufferMs": {
          "description": "How long a key or button press waits to be used, in milliseconds. A press made during knockback, an action lock or the Gulp wheel that is not used in time is dropped instead of firing late.",
          "type": "integer",
          "minimum": 0
        },
        "weaponWheelStepLockMs": {
          "description": "After the mouse wheel switches weapon, further scrolling is ignored until the wheel has been still this long, in milliseconds, so one trackpad swipe or wheel flick moves one weapon.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "nonNegative": {
      "type": "number",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "resourceTag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tags",
        "respawnMs"
      ],
      "properties": {
        "respawnMs": {
          "description": "How long a harvested tree, stone node or ore node stays gone, in milliseconds. It grows back the next time its map loads after this time, once its dropped piles are collected.",
          "type": "integer",
          "minimum": 1000
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resourceTag"
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "vitality",
        "agility",
        "intellect"
      ],
      "properties": {
        "strength": {
          "$ref": "#/$defs/nonNegative"
        },
        "vitality": {
          "$ref": "#/$defs/nonNegative"
        },
        "agility": {
          "$ref": "#/$defs/nonNegative"
        },
        "intellect": {
          "$ref": "#/$defs/nonNegative"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialMaxSlots",
        "maxStackByItem",
        "weaponMaxStack"
      ],
      "properties": {
        "initialMaxSlots": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxStackByItem": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/positiveInteger"
          }
        },
        "weaponMaxStack": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseSpeed",
        "boostSpeed",
        "dodgeSpeed",
        "dodgeDurationMs",
        "dodgeInvulnerabilityMs",
        "dodgeCooldownMs",
        "movementSpeedCap"
      ],
      "properties": {
        "baseSpeed": {
          "$ref": "#/$defs/nonNegative"
        },
        "boostSpeed": {
          "$ref": "#/$defs/nonNegative"
        },
        "dodgeSpeed": {
          "$ref": "#/$defs/nonNegative"
        },
        "dodgeDurationMs": {
          "description": "How long a dodge roll lasts, in milliseconds.",
          "type": "integer",
          "minimum": 1
        },
        "dodgeInvulnerabilityMs": {
          "type": "integer",
          "minimum": 0,
          "description": "How long the slime cannot be hurt from the start of a dodge roll, in milliseconds. At most dodgeDurationMs."
        },
        "dodgeCooldownMs": {
          "description": "Wait after a dodge roll ends before the next can start, in milliseconds.",
          "type": "integer",
          "minimum": 0
        },
        "movementSpeedCap": {
          "$ref": "#/$defs/nonNegative"
        }
      }
    },
    "playerStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxHp",
        "maxEnergy",
        "attack",
        "defense",
        "critChance",
        "critMultiplier",
        "energyRegenPerSecond"
      ],
      "properties": {
        "maxHp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxEnergy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "attack": {
          "$ref": "#/$defs/nonNegative"
        },
        "defense": {
          "$ref": "#/$defs/nonNegative"
        },
        "critChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critMultiplier": {
          "type": "number",
          "minimum": 1
        },
        "energyRegenPerSecond": {
          "$ref": "#/$defs/nonNegative"
        }
      }
    },
    "gooHeart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxHpBonus"
      ],
      "properties": {
        "maxHpBonus": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialAttributes",
        "movement",
        "hitInvulnerabilityMs",
        "stats",
        "gooHeart"
      ],
      "properties": {
        "initialAttributes": {
          "$ref": "#/$defs/attributes"
        },
        "movement": {
          "$ref": "#/$defs/movement"
        },
        "hitInvulnerabilityMs": {
          "type": "integer",
          "minimum": 0
        },
        "stats": {
          "$ref": "#/$defs/playerStats"
        },
        "gooHeart": {
          "$ref": "#/$defs/gooHeart"
        }
      }
    }
  }
}
