{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./enemy-types.schema.json",
  "title": "Slime Isa active enemy catalog",
  "type": "object",
  "required": ["types"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "types": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/enemy" }
    }
  },
  "$defs": {
    "enemy": {
      "type": "object",
      "required": ["id", "visualSetId", "maxHp", "body", "ai", "drop"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "visualSetId": { "type": "string" },
        "maxHp": { "type": "number", "exclusiveMinimum": 0 },
        "body": {
          "type": "object",
          "required": ["width", "height", "centerOffsetX", "centerOffsetY"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "centerOffsetX": { "type": "number" },
            "centerOffsetY": { "type": "number" }
          }
        },
        "ai": { "type": "object" },
        "drop": { "type": "object" },
        "projectile": { "type": "object" },
        "impactEffect": { "type": "object" }
      }
    }
  }
}
