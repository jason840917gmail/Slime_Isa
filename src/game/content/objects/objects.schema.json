{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./objects.schema.json",
  "title": "Slime Isa object archetype",
  "description": "One reusable game object per file. The object owns behavior and frame-specific collider, depth, and occlusion geometry.",
  "type": "object",
  "required": ["objectId", "selection", "variants", "physics", "tags"],
  "additionalProperties": false,
  "allOf": [
    { "not": { "required": ["collectible", "resourceNode"] } },
    {
      "if": { "required": ["collectible"] },
      "then": {
        "properties": {
          "physics": { "type": "null" },
          "tags": { "contains": { "const": "collectible" } }
        }
      }
    },
    {
      "if": { "properties": { "tags": { "contains": { "const": "collectible" } } }, "required": ["tags"] },
      "then": { "required": ["collectible"] }
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "objectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)+$"
    },
    "selection": { "const": "authored" },
    "variants": {
      "type": "array",
      "items": { "$ref": "#/$defs/variantGroup" },
      "minItems": 1
    },
    "physics": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/physics" }
      ]
    },
    "behavior": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)+$"
    },
    "collectible": { "$ref": "#/$defs/collectible" },
    "destructible": { "$ref": "#/$defs/destructible" },
    "resourceNode": { "$ref": "#/$defs/resourceNode" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "required": ["width", "height", "offsetX", "offsetY"],
      "additionalProperties": false,
      "properties": {
        "shape": { "enum": ["rectangle", "circle", "ellipse"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "radius": { "type": "integer", "minimum": 1 },
        "radiusX": { "type": "integer", "minimum": 1 },
        "radiusY": { "type": "integer", "minimum": 1 },
        "offsetX": { "type": "integer", "minimum": 0 },
        "offsetY": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "required": ["shape"], "properties": { "shape": { "const": "circle" } } }, "then": { "required": ["radius"] } },
        { "if": { "required": ["shape"], "properties": { "shape": { "const": "ellipse" } } }, "then": { "required": ["radiusX", "radiusY"] } }
      ]
    },
    "depthBounds": {
      "type": "object",
      "required": ["width", "height", "offsetX", "offsetY"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "offsetX": { "type": "integer", "minimum": 0 },
        "offsetY": { "type": "integer", "minimum": 0 }
      }
    },
    "frameVariant": {
      "type": "object",
      "required": ["visualId", "frame"],
      "additionalProperties": false,
      "properties": {
        "visualId": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)*$"
        },
        "frame": { "type": "integer", "minimum": 0 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scale": { "type": "number", "minimum": 0.05, "maximum": 8 },
        "visualOffset": { "$ref": "#/$defs/visualOffset" },
        "depthBounds": { "$ref": "#/$defs/depthBounds" },
        "occlusionBounds": { "$ref": "#/$defs/bounds" },
        "idleAnimationId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+(?:-[a-z0-9]+)*)+$"
        },
        "onHitAnimationId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+(?:-[a-z0-9]+)*)+$"
        },
        "collider": { "$ref": "#/$defs/bounds" }
      }
    },
    "visualOffset": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "variantGroup": {
      "type": "object",
      "required": ["assetId", "frames"],
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)+$"
        },
        "frames": {
          "type": "array",
          "items": { "$ref": "#/$defs/frameVariant" },
          "minItems": 1
        }
      }
    },
    "physics": {
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": {
        "body": { "const": "static" }
      }
    },
    "destructible": {
      "type": "object",
      "required": ["health", "drops"],
      "additionalProperties": false,
      "properties": {
        "health": { "type": "integer", "minimum": 1 },
        "drops": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "collectible": {
      "type": "object",
      "required": ["itemId", "quantity"],
      "additionalProperties": false,
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 }
      }
    },
    "resourceNode": {
      "type": "object",
      "required": ["health", "drop"],
      "additionalProperties": false,
      "properties": {
        "health": { "type": "integer", "minimum": 1 },
        "drop": { "$ref": "#/$defs/resourceDrop" },
        "hitEffectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "persistHealth": { "type": "boolean" },
        "depletionMessage": { "type": "string", "minLength": 1, "maxLength": 80 },
        "harvestRequirement": {
          "type": "object",
          "required": ["targetTag", "minimumTier", "failureMessage"],
          "additionalProperties": false,
          "properties": {
            "targetTag": { "type": "string", "minLength": 1 },
            "minimumTier": { "type": "integer", "minimum": 1 },
            "failureMessage": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        }
      }
    },
    "resourceDrop": {
      "type": "object",
      "required": ["objectId", "visualId", "pieces"],
      "additionalProperties": false,
      "properties": {
        "objectId": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)+$" },
        "visualId": { "type": "string", "minLength": 1 },
        "pieces": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
