{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slime-isa.local/schemas/scene.schema.json",
  "title": "Slime Isa Scene Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sceneId", "rootNodeId", "nodes", "instances"],
  "properties": {
    "version": { "const": 1 },
    "sceneId": { "$ref": "#/$defs/id" },
    "rootNodeId": { "$ref": "#/$defs/id" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "minItems": 1 },
    "instances": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
    "connections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
    "subresources": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "not": { "enum": [".", ".."] }, "pattern": "^[^/]+$" },
    "json": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["nodeId"],
      "properties": { "instancePath": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "nodeId": { "$ref": "#/$defs/id" } }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "type", "parentId", "order", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/name" }, "type": { "type": "string", "minLength": 1 },
        "scriptId": { "$ref": "#/$defs/id" }, "parentId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "order": { "type": "integer", "minimum": 0 }, "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      }
    },
    "override": {
      "type": "object", "additionalProperties": false, "required": ["sourceInstancePath", "sourceNodeId", "property", "value"],
      "properties": { "sourceInstancePath": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "sourceNodeId": { "$ref": "#/$defs/id" }, "property": { "type": "string", "minLength": 1 }, "value": { "$ref": "#/$defs/json" } }
    },
    "instance": {
      "type": "object", "additionalProperties": false, "required": ["instanceId", "name", "sceneId", "parentNodeId", "order", "overrides"],
      "properties": { "instanceId": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/name" }, "sceneId": { "$ref": "#/$defs/id" }, "parentNodeId": { "$ref": "#/$defs/id" }, "order": { "type": "integer", "minimum": 0 }, "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } } }
    },
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["source", "signal", "target", "handler"],
      "properties": { "source": { "$ref": "#/$defs/reference" }, "signal": { "$ref": "#/$defs/id" }, "target": { "$ref": "#/$defs/reference" }, "handler": { "$ref": "#/$defs/id" } }
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["version", "resourceId", "kind"],
      "properties": {
        "version": { "const": 1 }, "resourceId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["texture", "sprite-sheet", "collision-shape", "animation-library", "audio", "tile-set", "tile-data", "font", "theme"] },
        "assetId": { "type": "string", "minLength": 1 }, "frame": { "type": "integer", "minimum": 0 },
        "frameWidth": { "type": "integer", "minimum": 1 }, "frameHeight": { "type": "integer", "minimum": 1 }, "frameCount": { "type": "integer", "minimum": 1 },
        "value": { "$ref": "#/$defs/json" }, "animations": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }, "tiles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } },
        "tileSet": { "$ref": "#/$defs/id" }, "cells": { "type": "array", "items": { "$ref": "#/$defs/json" } }, "values": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      }
    }
  }
}
