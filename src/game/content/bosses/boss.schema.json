{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./boss.schema.json",
  "title": "Slime Isa boss definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "characterId", "visualSetId", "visualScale", "editorPreview", "maxHp", "body", "eye", "chaseSpeed", "contactHop", "leap", "allowedWeaponIds"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "characterId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "visualSetId": { "type": "string", "minLength": 1 },
    "visualScale": { "type": "number", "exclusiveMinimum": 0 },
    "editorPreview": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "idleFrame"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "idleFrame": { "type": "integer", "minimum": 0 }
      }
    },
    "maxHp": { "type": "number", "exclusiveMinimum": 0 },
    "body": { "$ref": "#/$defs/bounds" },
    "eye": { "$ref": "#/$defs/bounds" },
    "chaseSpeed": { "type": "number", "exclusiveMinimum": 0 },
    "contactHop": {
      "type": "object", "additionalProperties": false,
      "required": ["clipId", "hitboxId", "damage", "cooldownMs", "knockbackStrength"],
      "properties": {
        "clipId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9-]+)*$" },
        "hitboxId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9-]+)*$" },
        "damage": { "type": "number", "exclusiveMinimum": 0 },
        "cooldownMs": { "type": "integer", "minimum": 1 },
        "knockbackStrength": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "leap": {
      "type": "object", "additionalProperties": false,
      "required": ["cadenceMs", "smallHopCount", "smallHopDurationMs", "betweenHopsMs", "airTimeMs", "landingRadius", "landingDamage", "landingKnockbackStrength", "recoveryMs", "crackFadeMs"],
      "properties": {
        "cadenceMs": { "type": "integer", "minimum": 1 },
        "smallHopCount": { "const": 3 },
        "smallHopDurationMs": { "type": "integer", "minimum": 1 },
        "betweenHopsMs": { "type": "integer", "minimum": 1 },
        "airTimeMs": { "type": "integer", "minimum": 1 },
        "landingRadius": { "type": "number", "exclusiveMinimum": 0 },
        "landingDamage": { "type": "number", "exclusiveMinimum": 0 },
        "landingKnockbackStrength": { "type": "number", "exclusiveMinimum": 0 },
        "recoveryMs": { "type": "integer", "minimum": 1 },
        "crackFadeMs": { "type": "integer", "minimum": 1 }
      }
    },
    "allowedWeaponIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "effectImmunities": { "type": "array", "uniqueItems": true, "items": { "enum": ["knockback"] } }
  },
  "$defs": {
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "centerOffsetX": { "type": "number" },
        "centerOffsetY": { "type": "number" }
      },
      "anyOf": [
        { "required": ["offsetX", "offsetY"] },
        { "required": ["centerOffsetX", "centerOffsetY"] }
      ]
    }
  }
}
