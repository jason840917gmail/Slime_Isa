{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-set.schema.json",
  "title": "Slime Isa visual set",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "visualSetId", "assetId", "defaults", "clips"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "visualSetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)+$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)+$"
    },
    "defaults": { "$ref": "#/$defs/defaultTransform" },
    "frameVisuals": {
      "type": "object",
      "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" },
      "additionalProperties": { "$ref": "#/$defs/transform" }
    },
    "clips": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+([.-][a-z0-9-]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/clip" }
    }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "positivePair": {
      "type": "array",
      "items": { "type": "number", "exclusiveMinimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "originPair": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 2,
      "maxItems": 2
    },
    "transform": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "origin": { "$ref": "#/$defs/originPair" },
        "scale": { "$ref": "#/$defs/positivePair" },
        "sourceOffset": { "$ref": "#/$defs/pair" }
      }
    },
    "defaultTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "scale", "sourceOffset"],
      "properties": {
        "origin": { "$ref": "#/$defs/originPair" },
        "scale": { "$ref": "#/$defs/positivePair" },
        "sourceOffset": { "$ref": "#/$defs/pair" }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "framesPerSecond", "loop"],
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "framesPerSecond": { "type": "number", "exclusiveMinimum": 0, "maximum": 240 },
        "loop": { "type": "boolean" },
        "loopMode": { "type": "string", "enum": ["wrap", "ping-pong"] }
      }
    }
  }
}
