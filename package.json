{
  "name": "slime-open-world",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p scripts/tests/scene-browser/tsconfig.json",
    "assets:check": "node scripts/check-assets.mjs",
    "visuals:check": "node scripts/check-visuals.mjs",
    "characters:check": "node scripts/check-characters.mjs",
    "projectiles:check": "node scripts/check-projectiles.mjs",
    "weapons:check": "node scripts/check-weapons.mjs",
    "effects:check": "node scripts/check-effects.mjs",
    "enemies:check": "node scripts/check-enemies.mjs",
    "objects:check": "node scripts/check-objects.mjs",
    "maps:check": "node scripts/check-maps.mjs",
    "scenes:check": "node scripts/check-scenes.mjs",
    "scene-ownership:check": "node scripts/check-scene-ownership.mjs && node scripts/reconcile-scene-ledger.mjs",
    "scenes:convert": "node scripts/convert-scenes.mjs",
    "scenes:regenerate": "node scripts/convert-scenes.mjs --include-scene-owned --overwrite-scene-owned --apply",
    "quests:check": "node scripts/check-quests.mjs",
    "constants:generate": "node scripts/generate-game-constants-contract.mjs",
    "constants:check": "node scripts/check-game-constants.mjs",
    "functions:check": "node scripts/check-single-use.mjs",
    "maps:bake": "node scripts/bake-production-maps.mjs",
    "test:characters": "node --test scripts/tests/character-studio/*.test.mjs",
    "test:character-studio": "node --test scripts/tests/character-studio/*.test.mjs",
    "test:weapon-studio": "node --test scripts/tests/weapon-studio/*.test.mjs",
    "test:animation": "node --test scripts/tests/shared-animation/*.test.mjs",
    "test:combat": "node --test scripts/tests/combat/*.test.mjs",
    "test:bosses": "node --test --experimental-strip-types scripts/tests/bosses/*.test.mjs",
    "test:rendering": "node --test scripts/tests/rendering/*.test.mjs",
    "test:world-content": "node --test scripts/tests/world-content/*.test.mjs",
    "test:persistence": "node --test --experimental-strip-types scripts/tests/persistence/*.test.mjs",
    "test:collectibles": "node --test scripts/tests/collectibles/*.test.mjs",
    "test:quests": "node --test scripts/tests/quests/*.test.mjs",
    "test:npcs": "node --test scripts/tests/npcs/*.test.mjs",
    "test:ui": "node --test scripts/tests/modal-stack.test.mjs scripts/tests/crafting/*.test.mjs",
    "test:depth": "node scripts/test-depth.mjs",
    "test:game-constants": "node --test scripts/tests/game-constants/*.test.mjs",
    "test:progression": "node --test scripts/tests/progression/*.test.mjs",
    "test:scene-browser": "playwright test --config scripts/tests/scene-browser/playwright.config.ts",
    "test:scene-content": "node --test scripts/tests/scene-content/*.test.mjs",
    "test:scene-runtime": "node --test scripts/tests/scene-runtime/*.test.mjs",
    "test:scene-integration": "node --test scripts/tests/scene-integration/*.test.mjs",
    "test:scene-conversion": "node --test scripts/tests/scene-conversion/*.test.mjs",
    "test:scene-studio": "node --test scripts/tests/scene-studio/*.test.mjs",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm constants:check && pnpm assets:check && pnpm scenes:check && pnpm scene-ownership:check && pnpm visuals:check && pnpm characters:check && pnpm projectiles:check && pnpm effects:check && pnpm weapons:check && pnpm enemies:check && pnpm objects:check && pnpm maps:check && pnpm quests:check && pnpm test:scene-content && pnpm test:scene-runtime && pnpm test:scene-integration && pnpm test:scene-conversion && pnpm test:scene-studio && pnpm test:game-constants && pnpm test:progression && pnpm test:character-studio && pnpm test:animation && pnpm test:weapon-studio && pnpm test:combat && pnpm test:bosses && pnpm test:rendering && pnpm test:world-content && pnpm test:persistence && pnpm test:collectibles && pnpm test:quests && pnpm test:npcs && pnpm test:ui && pnpm test:depth && pnpm typecheck && pnpm build && pnpm test:scene-browser",
    "preview": "vite preview --port 3000"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.12",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
