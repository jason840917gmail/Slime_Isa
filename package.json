{
  "name": "slime-open-world",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "typecheck": "tsc --noEmit",
    "assets:check": "node scripts/check-assets.mjs",
    "visuals:check": "node scripts/check-visuals.mjs",
    "enemies:check": "node scripts/check-enemies.mjs",
    "objects:check": "node scripts/check-objects.mjs",
    "maps:check": "node scripts/check-maps.mjs",
    "maps:bake": "node scripts/bake-production-maps.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm assets:check && pnpm visuals:check && pnpm enemies:check && pnpm objects:check && pnpm maps:check && pnpm typecheck && pnpm build",
    "preview": "vite preview --port 3000"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
