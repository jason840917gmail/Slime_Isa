{
  "name": "slime-open-world",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "assets:check": "node scripts/check-assets.mjs",
    "animations:check": "node scripts/check-animations.mjs",
    "visuals:check": "node scripts/check-visuals.mjs",
    "characters:check": "node scripts/check-characters.mjs",
    "projectiles:check": "node scripts/check-projectiles.mjs",
    "weapons:check": "node scripts/check-weapons.mjs",
    "effects:check": "node scripts/check-effects.mjs",
    "enemies:check": "node scripts/check-enemies.mjs",
    "objects:check": "node scripts/check-objects.mjs",
    "maps:check": "node scripts/check-maps.mjs",
    "constants:check": "node scripts/check-game-constants.mjs",
    "functions:check": "node scripts/check-single-use.mjs",
    "maps:bake": "node scripts/bake-production-maps.mjs",
    "test:characters": "node --test scripts/tests/character-studio/*.test.mjs",
    "test:character-studio": "node --test scripts/tests/character-studio/*.test.mjs",
    "test:weapon-studio": "node --test scripts/tests/weapon-studio/*.test.mjs",
    "test:animation": "node --test scripts/tests/shared-animation/*.test.mjs",
    "test:animation-packages": "node --test scripts/tests/animation-packages/*.test.mjs",
    "test:combat": "node --test scripts/tests/combat/*.test.mjs",
    "test:object-animation": "node --test scripts/tests/object-animation/*.test.mjs",
    "test:rendering": "node --test scripts/tests/rendering/*.test.mjs",
    "test:persistence": "node --test --experimental-strip-types scripts/tests/persistence/*.test.mjs",
    "test:collectibles": "node --test scripts/tests/collectibles/*.test.mjs",
    "test:quests": "node --test scripts/tests/quests/*.test.mjs",
    "test:ui": "node --test scripts/tests/modal-stack.test.mjs",
    "test:map-editor": "node --test scripts/tests/map-editor/*.test.mjs",
    "test:depth": "node scripts/test-depth.mjs",
    "test:game-constants": "node --test scripts/tests/game-constants/*.test.mjs",
    "test:progression": "node --test scripts/tests/progression/*.test.mjs",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm constants:check && pnpm assets:check && pnpm animations:check && pnpm visuals:check && pnpm characters:check && pnpm projectiles:check && pnpm effects:check && pnpm weapons:check && pnpm enemies:check && pnpm objects:check && pnpm maps:check && pnpm test:game-constants && pnpm test:progression && pnpm test:character-studio && pnpm test:animation-packages && pnpm test:animation && pnpm test:weapon-studio && pnpm test:combat && pnpm test:object-animation && pnpm test:rendering && pnpm test:persistence && pnpm test:collectibles && pnpm test:quests && pnpm test:ui && pnpm test:map-editor && pnpm test:depth && pnpm typecheck && pnpm build",
    "preview": "vite preview --port 3000"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
